{
  "name": "uleditor",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "One open-source editor for code, Markdown, PDF, Word and Excel.",
  "scripts": {
    "dev": "node tools/ocr-assets.mjs && pnpm --filter @uleditor/shell-ui dev",
    "desktop": "pnpm --filter @uleditor/desktop dev",
    "build": "node tools/ocr-assets.mjs && pnpm -r --filter=!@uleditor/desktop build",
    "build:desktop": "pnpm --filter @uleditor/desktop build",
    "typecheck": "pnpm -r typecheck",
    "verify": "node tools/verify-ui.mjs",
    "verify:i18n": "node tools/verify-i18n.mjs",
    "verify:version": "node tools/verify-version.mjs",
    "verify:languages": "node tools/verify-languages.mjs",
    "verify:recent": "node tools/verify-recent.mjs",
    "verify:tree": "node tools/verify-tree.mjs",
    "verify:tree-desktop": "node tools/verify-tree-desktop.mjs",
    "i18n:template": "node tools/i18n-template.mjs",
    "verify:pdf": "node tools/verify-pdf-annotations.mjs && node tools/verify-pdf-pages.mjs && node tools/verify-pdf-text.mjs && node tools/verify-pdf-redact.mjs && node tools/verify-pdf-retype.mjs && node tools/verify-pdf-edit.mjs",
    "icons": "node tools/make-icons.mjs",
    "rust:test": "cargo test --workspace",
    "rust:lint": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "rust:wasm": "cargo build -p ul-formats --target wasm32-unknown-unknown --release",
    "check": "pnpm typecheck && pnpm verify:version && pnpm verify:languages && pnpm verify:recent && pnpm verify:i18n && pnpm build && pnpm rust:lint && pnpm rust:test",
    "clean": "pnpm -r exec rimraf dist node_modules/.vite",
    "verify:reading": "node tools/verify-reading.mjs",
    "verify:viewers": "node tools/verify-viewers.mjs",
    "verify:all": "node tools/verify-i18n.mjs && node tools/verify-ui.mjs && node tools/verify-viewers.mjs && node tools/verify-reading.mjs && node tools/verify-ocr.mjs && node tools/verify-export.mjs && node tools/verify-odf.mjs && node tools/verify-doc.mjs && pnpm verify:pdf",
    "verify:ocr": "node tools/verify-ocr.mjs",
    "verify:export": "node tools/verify-export.mjs",
    "verify:search": "node tools/verify-project-search.mjs",
    "verify:mobile": "node tools/verify-mobile-layout.mjs",
    "verify:library": "node tools/verify-mobile-library.mjs",
    "verify:pdf-editing": "node tools/verify-pdf-editing.mjs",
    "verify:docx": "node tools/verify-docx-edit.mjs",
    "verify:xlsx": "node tools/verify-xlsx-edit.mjs",
    "verify:xls": "node tools/verify-xls.mjs",
    "verify:odf": "node tools/verify-odf.mjs",
    "verify:doc": "node tools/verify-doc.mjs",
    "verify:docx-editing": "node tools/verify-docx-editing.mjs",
    "android:build": "powershell -ExecutionPolicy Bypass -File tools/android-dev.ps1 -Build",
    "ocr:assets": "node tools/ocr-assets.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  }
}
