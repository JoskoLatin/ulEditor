<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Access to documents on the device.

      Without this the editor on Android sees nothing: under scoped storage,
      `readdir` over shared storage lets only directories through and filters out
      every file. Measured on a device — `adb` saw around 60 documents in
      `Download`, the app saw seven empty folders.

      `MANAGE_EXTERNAL_STORAGE` is the only permission that also covers documents
      (PDF, DOCX, EPUB), because `READ_MEDIA_*` spans images, audio and video
      only. The user turns it on by hand in the system settings; the system does
      not offer it through an ordinary dialog.

      **For Google Play this is not enough** — there the permission is granted
      mostly to file managers. Publishing on Play requires SAF
      (`ACTION_OPEN_DOCUMENT_TREE`), which in turn requires a VFS layer that
      handles `content://` URIs. See `docs/adr/0001-runtime.md`.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.uleditor_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
