    "--chrome": "paper-2",
    "--surface": "paper",
    "--surface-raised": "paper",
    "--overlay": "paper",
    "--ink": "ink",
    "--ink-soft": "ink-2",
    "--ink-faint": "ink-3",
    "--ink-ghost": "ink-4",
    "--ink-inverse": "paper",
    "--rule": "paper-3",
    "--rule-soft": "paper-2",
    "--rule-strong": "paper-4",
    "--accent": "stamp",
    "--accent-hover": "stamp-deep",
    "--accent-ink": "stamp",
    "--accent-wash": "stamp-soft",
    "--ok": "stamp",
    "--warn": "amber",
