    "--ceduljica-shadow": { "light": "0 1px 2px rgb(0 0 0 / 0.15), 0 12px 22px rgb(30 20 0 / 0.22)", "dark": "0 1px 2px rgb(0 0 0 / 0.4), 0 12px 22px rgb(0 0 0 / 0.5)" },
    "--ugao-shadow": { "light": "rgb(20 12 80 / 0.3)", "dark": "rgb(0 0 0 / 0.55)" },
    "--lifted-shadow": { "light": "0 8px 14px rgb(0 0 0 / 0.45)", "dark": "0 0 0 2px rgb(255 255 255 / 0.2), 0 8px 14px rgb(0 0 0 / 0.6)" }
  },
  "fixed": {
    "--arak-face": "\"Roboto Condensed\", \"sans-serif-condensed\", Bahnschrift, \"Arial Narrow\", system-ui, sans-serif",
    "--arak-corner": "68px"
  },
  "pairs": [
    { "fg": "--ink", "bg": "--surface", "kind": "text", "what": "a document's ink on the paper" },
    { "fg": "--ink-soft", "bg": "--surface", "kind": "text", "what": "secondary ink on the paper" },
    { "fg": "--ink-faint", "bg": "--surface", "kind": "text", "what": "faint ink the editors write, on the paper" },
    { "fg": "--ink", "bg": "--ground", "kind": "text", "what": "ink on the editors' ground" },
    { "fg": "--ink-soft", "bg": "--ground", "kind": "text", "what": "secondary ink on the editors' ground" },
    { "fg": "--ink-faint", "bg": "--ground", "kind": "text", "what": "faint ink on the editors' ground" },
    { "fg": "--accent", "bg": "--surface", "kind": "text", "what": "the stamp's ink: what the program writes on the paper" },
    { "fg": "--accent-hover", "bg": "--surface", "kind": "text", "what": "the stamp's ink, pressed" },
    { "fg": "--accent", "bg": "--accent-wash", "kind": "text", "what": "the stamp's ink on its wash" },
    { "fg": "--ink", "bg": "--accent-wash", "kind": "text", "what": "ink on the stamp's wash (a selected row)" },
    { "fg": "--zig-ink", "bg": "--zig", "kind": "text", "what": "a label on the stamp's button" },
    { "fg": "--danger", "bg": "--surface", "kind": "text", "what": "an error said on the paper" },
    { "fg": "--ink", "bg": "--danger-wash", "kind": "text", "what": "ink on an error's wash" },
    { "fg": "--warn", "bg": "--surface", "kind": "text", "what": "a warning said on the paper" },
    { "fg": "--ink", "bg": "--warn-wash", "kind": "text", "what": "ink on a warning's wash" },
    { "fg": "--signir-ink", "bg": "--hit", "kind": "text", "what": "a found word on the marker" },
    { "fg": "--signir-ink", "bg": "--signir", "kind": "text", "what": "ink on the marker" },
    { "fg": "--ceduljica-ink", "bg": "--ceduljica", "kind": "text", "what": "a first-time hint on its sticky note" },
    { "fg": "--stol-ink", "bg": "--stol", "kind": "text", "what": "the desk's text on the desk" },
    { "fg": "--stol-ink-soft", "bg": "--stol", "kind": "text", "what": "the desk's secondary text on the desk" },
    { "fg": "--stol-ink", "bg": "--stol-field", "kind": "text", "what": "the desk's text on a pressed tool" },
    { "fg": "--stol-ink-soft", "bg": "--stol-field", "kind": "text", "what": "the desk's secondary text on a pressed tool" },
    { "fg": "--hit-current", "bg": "--surface", "kind": "other", "what": "the ring round the current hit, against the paper" },
    { "fg": "--ugao-edge", "bg": "--surface", "kind": "other", "what": "the folded corner's edge against the paper" },
    { "fg": "--unsaved", "bg": "--surface", "kind": "other", "what": "the red dot of unsaved work, on the paper" },
    { "fg": "--stol-unsaved", "bg": "--stol", "kind": "other", "what": "the red dot of unsaved work, on the desk" },
    { "fg": "--signir", "bg": "--stol", "kind": "other", "what": "the focus ring on the desk" },
    { "fg": "--accent", "bg": "--ground", "kind": "other", "what": "the focus ring and a field's line on the editors' ground" },
    { "fg": "--stol-ink-soft", "bg": "--stol", "kind": "other", "what": "the dashed edge of the tile back to the wall" },
    { "fg": "--zig", "bg": "--surface", "kind": "other", "what": "the stamp's button against the paper" }
  ]
