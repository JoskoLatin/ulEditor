  "values": {
    "--overlay-scrim": { "light": "rgb(16 8 70 / 0.42)", "dark": "rgb(0 0 0 / 0.6)" },
    "--accent-glow": { "light": "rgb(63 53 181 / 0.16)", "dark": "rgb(171 163 255 / 0.2)" },
