    "paper-3": { "light": "#D9D6E8", "dark": "#47435E" },
    "paper-4": { "light": "#B9B5CC", "dark": "#5C5876" },
    "ink": { "light": "#1D1A33", "dark": "#E9E6F4" },
    "ink-2": { "light": "#5A5670", "dark": "#A9A4C0" },
    "ink-3": { "light": "#67637D", "dark": "#9A95B3" },
