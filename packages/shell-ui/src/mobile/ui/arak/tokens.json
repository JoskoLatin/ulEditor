    "marker": { "light": "#FFE24D", "dark": "#F0D646" },
    "marker-ink": { "light": "#1D1A33", "dark": "#1B1630" },
    "red": { "light": "#C42B2B", "dark": "#FF8A80" },
    "red-wash": { "light": "#F9E4E4", "dark": "#40262F" },
    "red-on-desk": { "light": "#FF8A80", "dark": "#FF8A80" },
    "amber": { "light": "#865600", "dark": "#E3CF63" },
    "amber-wash": { "light": "#FFF0A6", "dark": "#3B3322" },
