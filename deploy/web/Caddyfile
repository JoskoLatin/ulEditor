# ulEditor, the browser build — the static `dist` and the headers it needs.
#
# Served inside the container on plain :8080; TLS is the shared Caddy's job, which
# reverse-proxies uleditor.truss here over the internal `caddy-uleditor` network (ADR 0002,
# step 7). This file is the one place the web build's policy lives, and
# tools/verify-web-csp.mjs serves the build with the policy read from here.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv/site
	encode zstd gzip

	header {
		# The desktop policy in tauri.conf.json, less what only Tauri has
		# (ipc:, ipc.localhost), plus what a page on the open web should say
		# about being framed and where forms go. Google Fonts stays: a PDF
		# line in a font the screen lacks can be fetched for display, and
		# only when the person presses the button that says so.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# `instantiateStreaming` wants this exact type.
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Vite names every asset by its content, so one that exists never changes
	# under its name and is kept for a year. One that does not exist is a 404,
	# never index.html: a tab left open across a deploy asks for a chunk of
	# the old build, and index.html cached a year under that name would stay
	# broken even after a rollback.
	handle /assets/* {
		@present file
		handle @present {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			header Cache-Control "no-store"
			respond "Not found" 404
		}
	}

	# The service worker, the WebAssembly and OCR keep one name across builds,
	# so they are asked again each time. One that does not exist is a 404 too:
	# index.html under the name of a module would be run, or kept, as one — and
	# a missing sw.js answered with a page reads to the browser as a broken
	# update, not an absent worker.
	@public path /sw.js /wasm/* /ocr/*
	handle @public {
		@present file
		handle @present {
			header Cache-Control "no-cache"
			file_server
		}
		handle {
			header Cache-Control "no-store"
			respond "Not found" 404
		}
	}

	# Everything else is the page itself, asked again each time.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
