node_modules/
dist/
target/
*.tsbuildinfo
.DS_Store
Thumbs.db
.vite/
apps/desktop/src-tauri/target/

# Generated mobile projects.
#
# Android is the exception and must be versioned: its manifest carries the
# permissions without which the app on a phone sees no files at all. Were the
# folder ignored, that edit would be lost on every regeneration.
#
# Inside that folder Tauri already leaves its own `.gitignore` files excluding
# every build output — the compiled `.so`, the generated Kotlin and
# `tauri.conf.json`. About 460 KB of sources remain.
apps/desktop/src-tauri/gen/*
!apps/desktop/src-tauri/gen/android
tools/screenshots/
*.local
.env
.env.*
!.env.example

# OCR assets are copied out of node_modules on every build (tools/ocr-assets.mjs).
packages/shell-ui/public/ocr/

# Output of the elevated Android build (tools/android-dev.ps1).
tools/android-dev.log

# The Android signing key.
#
# Never in the repository: whoever holds it can publish an app under the
# `org.uleditor.app` identity. `keystore.properties` is already caught by Tauri's
# own .gitignore inside `gen/android`; it is repeated here for safety.
*.jks
*.keystore
keystore.properties
